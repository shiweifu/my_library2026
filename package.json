{
  "name": "my-cultural-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm content:validate && vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "record:add": "node --import tsx scripts/add-record.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@heroicons/vue": "^2.2.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.17.1"
}
